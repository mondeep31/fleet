{
  "name": "fleet",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup:hooks": "git config core.hooksPath .githooks && chmod +x .githooks/pre-commit .githooks/pre-push",
    "migrate:env": "bun run scripts/migrate-env.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.exclude='apps/dashboard/**' --coverage.exclude='vitest.config.ts' --coverage.exclude='index.ts'",
    "test:ui": "bun run --cwd apps/dashboard lint && bun run --cwd apps/dashboard build",
    "dev:api": "cd apps/api && bun run dev",
    "dev:worker": "cd apps/worker && bun run dev",
    "dev:agent": "cd apps/agent && bun run dev",
    "dev:dashboard": "cd apps/dashboard && bun run dev",
    "dev:cli": "cd apps/cli && bun run dev"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5",
    "@vitest/coverage-v8": "^3.2.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  }
}
