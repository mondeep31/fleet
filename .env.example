# MongoDB — paste your Atlas connection string here
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/fleet

# Redis — local via docker compose
REDIS_URL=redis://localhost:16379

# Auth
JWT_SECRET=replace_with_at_least_32_characters

# GitHub
GITHUB_WEBHOOK_SECRET=your_webhook_secret
GITHUB_CLIENT_ID=your_oauth_client_id
GITHUB_CLIENT_SECRET=your_oauth_client_secret
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3010/v1/auth/github/callback
GITHUB_OAUTH_SCOPES=read:user user:email repo

# Agent
AGENT_TOKEN=your_agent_token

# API
PORT=3010
API_URL=http://localhost:3010
DASHBOARD_URL=http://localhost:3000

# Node
NODE_ENV=development
