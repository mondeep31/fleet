# MongoDB — paste your Atlas connection string here
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/fleet

# Redis — local via docker compose
REDIS_URL=redis://localhost:16379

# Auth
JWT_SECRET=replace_with_at_least_32_characters

# GitHub webhook secret — used to verify HMAC signatures on push deliveries.
# GitHub registers this automatically when a project is created.
# Generate: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# GitHub OAuth App — for connected integration (repo picker / new project flow).
# Create at https://github.com/settings/developers → OAuth Apps.
# Callback URL must match GITHUB_OAUTH_CALLBACK_URL exactly.
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3010/api/v1/integrations/github/callback
GITHUB_OAUTH_SUCCESS_REDIRECT=http://localhost:3000/projects

# Agent
AGENT_TOKEN=your_agent_token

# Email (Resend) — https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Fleet <onboarding@resend.dev>
DASHBOARD_URL=http://localhost:3000

# API
PORT=3010
# In production this must be a publicly reachable HTTPS URL so GitHub can
# deliver webhooks. Fleet registers https://{API_URL}/webhooks/github on each
# new GitHub project.
API_URL=http://localhost:3010

# Node
NODE_ENV=development

# Traefik routing (Phase 1: local HTTP)
FLEET_APPS_DOMAIN=localhost
FLEET_PUBLIC_URL_SCHEME=http
FLEET_TRAEFIK_PUBLIC_PORT=18080
FLEET_TRAEFIK_NETWORK=fleet-proxy

# Secrets encryption — base64-encoded 32-byte key for project env vars at rest
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FLEET_SECRETS_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key

# Production deploy URLs (mondeep.xyz example)
# FLEET_APPS_DOMAIN=mondeep.xyz
# FLEET_PUBLIC_URL_SCHEME=https
# FLEET_TRAEFIK_PUBLIC_PORT=
