# MongoDB — paste your Atlas connection string here
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/fleet

# Redis — local via docker compose
REDIS_URL=redis://localhost:16379

# Auth
JWT_SECRET=replace_with_at_least_32_characters

# GitHub webhook secret — used to verify HMAC signatures on push deliveries.
# GitHub registers this automatically when a project is created.
# Generate: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# GitHub OAuth App — for connected integration (repo picker / new project flow).
# Create at https://github.com/settings/developers → OAuth Apps.
# Callback URL must match GITHUB_OAUTH_CALLBACK_URL exactly.
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3010/api/v1/integrations/github/callback
GITHUB_OAUTH_SUCCESS_REDIRECT=http://localhost:3000/projects

# GitHub OAuth App — for login/signup (separate app; requests repo scopes on sign-in).
# Create at https://github.com/settings/developers → OAuth Apps.
# Callback URL must match GITHUB_LOGIN_CALLBACK_URL exactly.
GITHUB_LOGIN_CLIENT_ID=your_github_login_oauth_app_client_id
GITHUB_LOGIN_CLIENT_SECRET=your_github_login_oauth_app_client_secret
GITHUB_LOGIN_CALLBACK_URL=http://localhost:3010/v1/auth/github/callback

# Agent
AGENT_TOKEN=your_agent_token

# Email (Resend) — https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Fleet <onboarding@resend.dev>
DASHBOARD_URL=http://localhost:3000

# API — public URL for GitHub webhooks and OAuth callback registration (API process)
PORT=3010
API_URL=http://localhost:3010
# Loopback URL for dashboard rewrites and server-side API fetches (dashboard process)
API_INTERNAL_URL=http://127.0.0.1:3010

# Node
NODE_ENV=development

# Traefik routing (Phase 1: local HTTP)
FLEET_APPS_DOMAIN=localhost
FLEET_PUBLIC_URL_SCHEME=http
FLEET_TRAEFIK_PUBLIC_PORT=18080
FLEET_TRAEFIK_NETWORK=fleet-proxy
FLEET_TRAEFIK_CONTAINER=fleet-traefik
# Host directory bind-mounted into Traefik's file provider for custom-domain
# routing (see docker-compose.yml). In production, point this at a persistent
# directory, not /tmp — e.g. /opt/fleet/traefik-dynamic — and mkdir it first.
FLEET_TRAEFIK_DYNAMIC_DIR=/tmp/fleet-traefik-dynamic

# Cloudflare for SaaS — custom domains (optional; feature 503s cleanly without
# these rather than breaking startup). Requires a one-time, zone-level Cloudflare
# for SaaS + fallback origin setup done outside this app — see docs/CONTEXT.md.
# Token scope: Zone:SSL and Certificates:Edit, Zone:Custom Hostnames:Edit,
# restricted to the zone below.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# Dashboard-only (build-time inlined): the fallback-origin hostname customers
# must CNAME their domain to. This is the routing record — separate from and
# in addition to the ownership-verification record Cloudflare returns per
# domain. Without this set, the dashboard won't show the CNAME instruction.
NEXT_PUBLIC_FLEET_DOMAIN_CNAME_TARGET=saas-fallback.mondeep.xyz

# Optional: override plan compute limits (JSON). Defaults live in packages/config/plans.ts
# FLEET_PLAN_LIMITS_JSON={"pro":{"memoryMb":2048,"nanoCpus":2000000000,"pidsLimit":512,"tmpfsMb":128}}

# Secrets encryption — base64-encoded 32-byte key for project env vars at rest
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FLEET_SECRETS_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key

# Google Analytics (dashboard — inlined at build time)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Production deploy URLs (mondeep.xyz example)
# FLEET_APPS_DOMAIN=mondeep.xyz
# FLEET_PUBLIC_URL_SCHEME=https
# FLEET_TRAEFIK_PUBLIC_PORT=
