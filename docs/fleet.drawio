        <mxCell id="e-email-resend" value="Resend API" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#fb923c;strokeWidth=1.5;fontColor=#fb923c;fontSize=10;fontStyle=3;endArrow=block;endFill=1;" edge="1" source="step-email" target="svc-resend" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Run → Redis (log publish, dashed) -->
        <mxCell id="e-logs-redis" value="publish logs (Redis Streams)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;dashed=1;dashPattern=8 4;strokeColor=#f87171;strokeWidth=1.5;fontColor=#f87171;fontSize=10;fontStyle=3;endArrow=open;endFill=0;" edge="1" source="step-run" target="svc-redis" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="980" y="778" />
              <mxPoint x="1170" y="778" />
              <mxPoint x="1170" y="460" />
              <mxPoint x="1044" y="460" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Docker ↔ Traefik -->
        <mxCell id="e-docker-traefik" value="network attach" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#34d399;strokeWidth=1.5;fontColor=#34d399;fontSize=10;fontStyle=3;startArrow=block;startFill=1;endArrow=block;endFill=1;" edge="1" source="svc-docker" target="svc-traefik" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Traefik → Deployed Apps zone -->
        <mxCell id="e-traefik-deployed" value="route traffic" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#a78bfa;strokeWidth=1.5;fontColor=#a78bfa;fontSize=10;fontStyle=3;endArrow=block;endFill=1;" edge="1" source="svc-traefik" target="zone-deployed" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Browser → Deployed Apps (dashed, app traffic) -->
        <mxCell id="e-browser-app" value="app traffic (direct to subdomain)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;dashed=1;dashPattern=8 4;strokeColor=#475569;strokeWidth=1;fontColor=#64748b;fontSize=10;endArrow=block;endFill=1;opacity=60;" edge="1" source="svc-browser" target="zone-deployed" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="112" y="1005" />
              <mxPoint x="1200" y="1005" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
